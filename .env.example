# Wallet address to receive USDC payments (Base mainnet)
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Network ID (Base mainnet)
NETWORK_ID=eip155:8453

# Japan: 国税庁法人番号API key
# Register at: https://www.houjin-bangou.nta.go.jp/webapi/
HOUJIN_API_KEY=

# Korea: 공공데이터포털 API key
# Register at: https://www.data.go.kr/
KR_DATA_API_KEY=

# Singapore: ACRA BizFile+ API key
# Register at: https://www.acra.gov.sg/
ACRA_API_KEY=

# x402 Facilitator URL (default: https://x402.org/facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Base URL of this deployment (used for resource URLs in payment requirements)
NEXT_PUBLIC_BASE_URL=https://apac-kyc-api.vercel.app
